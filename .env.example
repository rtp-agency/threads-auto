# --- Threads / Meta ---
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=https://your-domain.example/auth/threads/callback

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# chat_id клиента: сюда приходят черновики, отчёты и т.д.
TELEGRAM_ADMIN_CHAT_ID=

# --- LLM ---
# провайдер текстовой генерации: openai | xai | anthropic
#   xai (Grok) — менее цензурированный, лучше для резкого/юморного тона.
LLM_PROVIDER=openai
OPENAI_API_KEY=
# ключ xAI (нужен только при LLM_PROVIDER=xai): console.x.ai
XAI_API_KEY=
# каскад моделей: дешёвая для классификации/фильтров, основная для постов.
# openai:    CLASSIFIER_MODEL=gpt-5-nano   GENERATION_MODEL=gpt-5-mini (или gpt-5)
# xai:       CLASSIFIER_MODEL=grok-4.3     GENERATION_MODEL=grok-4.5
# anthropic: CLASSIFIER_MODEL=claude-haiku-4-5  GENERATION_MODEL=claude-sonnet-5
CLASSIFIER_MODEL=gpt-5-nano
GENERATION_MODEL=gpt-5-mini
ANTHROPIC_API_KEY=

# --- Эмбеддинги (few-shot retrieval, pgvector): openai | voyage ---
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
VOYAGE_API_KEY=

# --- Генерация изображений (POV-скриншоты) ---
# провайдер: openai | gemini
IMAGE_GEN_PROVIDER=openai
IMAGE_GEN_API_KEY=
# модель генерации картинок
IMAGE_MODEL=gpt-image-2
# как рисовать скриншот-уведомление: ai (нейросеть по референсам клиента) |
# template (программный рендер Pillow с фикс-аватарками)
NOTIFICATION_RENDER_MODE=ai

# --- Инфраструктура ---
DATABASE_URL=postgresql+psycopg2://threads:threads@db:5432/threads
REDIS_URL=redis://redis:6379/0

# ключ Fernet для шифрования access-токенов (сгенерировать:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
TOKEN_ENCRYPTION_KEY=

# --- Тренды ---
NEWS_SOURCE_URL=https://news.google.com/rss?hl=uk&gl=UA&ceid=UA:uk

# --- Медиа (картинки должны быть доступны Threads по публичному URL) ---
PUBLIC_BASE_URL=https://your-domain.example
MEDIA_DIR=/data/media

# --- Отчёты ---
# день недели еженедельного отчёта (0=понедельник ... 6=воскресенье)
REPORT_WEEKDAY=1
REPORT_HOUR=10
